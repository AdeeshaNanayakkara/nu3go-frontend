# ─────────────────────────────────────────────────────────────────────────────
# Nu3Go frontend — environment variables
# Copy to .env.local for local development:   cp .env.example .env.local
# In production, set these in your hosting provider's dashboard (never commit real values).
# Variables WITHOUT the NEXT_PUBLIC_ prefix stay on the server only.
# ─────────────────────────────────────────────────────────────────────────────

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://13.201.222.82:80
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ─── Contact form: SMTP (Nodemailer) ───
# Port 587 = STARTTLS (SMTP_SECURE=false), port 465 = implicit TLS (SMTP_SECURE=true).
# Gmail / Google Workspace: smtp.gmail.com, 587, and an App Password (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender shown in both emails. Must be an address your SMTP account may send as
# (for best deliverability, a domain with SPF/DKIM/DMARC configured).
MAIL_FROM_NAME=nu3go
MAIL_FROM_ADDRESS=

# Where new enquiries are delivered. Comma-separate multiple addresses.
CONTACT_ADMIN_EMAIL=

# Optional: extra origins allowed to POST /api/contact (comma-separated full URLs),
# e.g. a preview/staging domain. The current host and NEXT_PUBLIC_APP_URL are always allowed.
CONTACT_ALLOWED_ORIGINS=
